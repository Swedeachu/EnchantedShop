# Dependencies - restored via `npm install` (package-lock.json is committed)
node_modules/

# Build output - packs/EnchantedShop_BP/scripts/main.js and its sourcemap
# are generated by `npm run build` (see build.mjs); never hand-edited.
dist/
packs/**/scripts/*.js
packs/**/scripts/*.js.map
*.tsbuildinfo

# The Bedrock Dedicated Server itself - this is Mojang's ~200MB+ zip
# extracted locally (see README's setup steps), plus everything it
# generates at runtime: the actual world save, player/ops config, logs.
# None of this is our source and none of it belongs in the repo -
# server.properties and permissions.json in particular carry this
# specific server's runtime config (and permissions.json carries real
# player xuids), not project config, so they're deliberately excluded
# too rather than tracked as "defaults".
server/

# Editor/OS noise
.vscode/
.idea/
*.log
.DS_Store
Thumbs.db
